# If not set, server picks a free port from 3000-3100.
# If set, it must be free (unique) on your machine.
PORT=5000
# CORS: comma-separated origins for your frontend (Next.js)
# Example: CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Use "*" to allow all origins (not recommended for production).
CORS_ORIGINS=http://localhost:5000
# CORS details (browser calls). Use comma-separated values.
# Example: CORS_METHODS=POST,OPTIONS
CORS_METHODS=GET,POST,OPTIONS
# Example: CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOWED_HEADERS=Content-Type,Authorization
# Set to 1 only if your frontend uses fetch(..., { credentials: "include" })
CORS_CREDENTIALS=0

# If your app is behind a proxy/load balancer (rare for local dev), set this:
TRUST_PROXY=0

# Auth tokens
# Access token is returned in JSON and typically stored in frontend memory.
# Refresh token is stored in an HttpOnly cookie (requires CORS_CREDENTIALS=1 on cross-origin fetch).
ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SAMESITE=lax
COOKIE_SECURE=0

# MySQL connection for Node app
# If you use docker-compose.yml below, keep these values.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=appuser
DB_PASSWORD=AppPass123!
DB_NAME=demo_app

# If you use the included docker-compose.yml (optional)
MYSQL_PORT=3307
PMA_PORT=8081
MYSQL_ROOT_PASSWORD=rootpass123!
